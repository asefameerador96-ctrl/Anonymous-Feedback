# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit your real secrets.

# --- Database -------------------------------------------------------------
# Azure Database for PostgreSQL (Flexible Server) connection string.
# Find it in the Azure portal: your DB → Settings → Connection strings → "ADO"
# /"Node.js", or build it from the fields below.
#
#   postgres://USER:PASSWORD@HOST.postgres.database.azure.com:5432/DBNAME?sslmode=require
#
DATABASE_URL=

# Set to "disable" ONLY when pointing at a local Postgres without TLS.
# Leave unset for Azure (Azure requires SSL).
# PGSSL=disable

# --- Admin auth -----------------------------------------------------------
# Email for the /admin dashboard login. If left unset, the login is
# password-only (no email field is enforced).
ADMIN_EMAIL=

# Password for the /admin dashboard. Make it long.
ADMIN_PASSWORD=

# Secret used to sign admin session cookies. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# --- Email (optional) -----------------------------------------------------
# SMTP relay for one-click code emails. Works with any provider (Brevo,
# SendGrid, Azure Communication Services, etc.). If unset, the app falls back
# to the mail-merge CSV export.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=true   # only if your provider requires TLS-on-connect (port 465)
